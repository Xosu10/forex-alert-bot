# URL del webhook de Discord (Servidor -> Canal -> Integraciones -> Webhooks)
DISCORD_WEBHOOK_URL=

# Minutos antes del evento para el aviso previo
ALERT_MINUTES_BEFORE=30

# Minutos tras el evento durante los que se sigue comprobando si ya hay dato publicado
ACTUAL_CHECK_WINDOW_MINUTES=60

# Cada cuántos minutos se comprueba el calendario
CHECK_INTERVAL_MINUTES=5

# Hora (España, formato 24h) a la que se envía el resumen del día
DAILY_SUMMARY_HOUR=8
