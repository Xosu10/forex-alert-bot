# URL del webhook de Discord (Servidor -> Canal -> Integraciones -> Webhooks)
DISCORD_WEBHOOK_URL=

# Minutos antes del evento para el recordatorio con el procedimiento a seguir
REMINDER_MINUTES_BEFORE=60

# Minutos antes del evento para el aviso previo corto
ALERT_MINUTES_BEFORE=30

# Minutos tras el evento durante los que se sigue comprobando si ya hay dato publicado
ACTUAL_CHECK_WINDOW_MINUTES=60

# Hora (España, formato 24h) a la que se envían el resumen diario y, los lunes, el semanal
SUMMARY_HOUR=1
